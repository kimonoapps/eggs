  "scripts": {
    "installation": {
      "container": "alpine:3.22",
      "entrypoint": "sh",
      "script": "#!/bin/sh\nset -eu\nmkdir -p /mnt/server\necho \"Runtime is supplied by the custom Docker image.\"\n"
    }
  },
  "variables": [
    {
      "name": "AUTHENTIK_POSTGRESQL__HOST",
      "description": "Reachable PostgreSQL VM IP / hostname",
      "env_variable": "AUTHENTIK_POSTGRESQL__HOST",
      "default_value": "",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string",
      "field_type": "text"
    },
    {
      "name": "AUTHENTIK_POSTGRESQL__PORT",
      "description": "PostgreSQL allocated port",
      "env_variable": "AUTHENTIK_POSTGRESQL__PORT",
      "default_value": "5432",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string",
      "field_type": "text"
    },
    {
      "name": "AUTHENTIK_POSTGRESQL__NAME",
      "description": "",
      "env_variable": "AUTHENTIK_POSTGRESQL__NAME",
      "default_value": "authentik",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string",
      "field_type": "text"
    },
    {
      "name": "AUTHENTIK_POSTGRESQL__USER",
      "description": "",
      "env_variable": "AUTHENTIK_POSTGRESQL__USER",
      "default_value": "authentik",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string",
      "field_type": "text"
    },
    {
      "name": "AUTHENTIK_POSTGRESQL__PASSWORD",
